local directions = {"Bk (Đằng sau)", "Dn (Bên dưới)", "Ft (Đằng trước)", "Lf (Bên trái)", "Rt (Bên phải)", "Up (Bên trên)"}
local textBoxBoxes = {}

for i, dir in ipairs(directions) do
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 260, 0, 35)
    box.Position = UDim2.new(0.5, -130, 0, 15 + (i * 45))
    box.PlaceholderText = "Nhập Asset ID cho mặt " .. dir
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.Parent = Frame
    
    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 5)
    boxCorner.Parent = box
    
    local key = string.sub(dir, 1, 2)
    textBoxBoxes[key] = box
end

